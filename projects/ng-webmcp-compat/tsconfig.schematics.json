{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["es2022"],
    "declaration": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": "schematics",
    "outDir": "../../dist/ng-webmcp-compat/schematics"
  },
  "include": ["schematics/**/*.ts"],
  "exclude": ["schematics/**/*.spec.ts"]
}
